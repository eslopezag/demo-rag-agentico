# Copien este archivo como .env y pongan su clave de https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Modelo de chat. Cualquiera de https://openrouter.ai/models que use herramientas.
MODELO=z-ai/glm-5.3

# Base de datos de la carpeta base_de_datos/ (docker compose up -d).
# No la llamen DATABASE_URL: con ese nombre Chainlit intenta guardar ahí el
# historial de los chats y falla con "No module named 'asyncpg'".
URL_BD=postgresql://tienda:tienda@localhost:5432/tienda

# Chainlit firma con este secreto la sesión de quien inicia sesión. Es fijo para
# que la demostración corra sin pasos extra. En producción, cada despliegue
# genera el suyo con `chainlit create-secret` y nunca lo publica.
CHAINLIT_AUTH_SECRET=tienda-condor-secreto-fijo-de-la-demo-no-usar-en-produccion
